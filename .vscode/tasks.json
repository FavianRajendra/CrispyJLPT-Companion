{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev:web-server",
      "type": "shell",
      "command": "npm run dev:web",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v.* ready in",
          "endsPattern": "Local:.*http://localhost:1420/"
        }
      }
    },
    {
      "label": "build:tauri-dev-backend",
      "type": "shell",
      "command": "cargo build --manifest-path src-tauri/Cargo.toml",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "tauri:dev",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true
    }
  ]
}
